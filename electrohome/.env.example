# Copia este archivo como ".env" (mismo folder) y completa tus propios valores.
# ".env" está en .gitignore: nunca se sube a GitHub.
#
# Para desarrollo LOCAL, la mayoría de estas variables son OPCIONALES:
# si las dejas vacías, el proyecto usa valores seguros por defecto
# (SQLite local, envío de correos por consola, sin Cloudinary).

DJANGO_SETTINGS_MODULE=electrohome.settings.local

# Obligatoria: usa cualquier cadena larga y aleatoria en local.
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# Opcional en local. Si se deja vacía, se usa SQLite (db.sqlite3).
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=

# Opcional en local (funciones de IA del chatbot quedarán deshabilitadas si está vacía).
ANTHROPIC_API_KEY=

# Opcional en local. Si se deja vacía, los correos se imprimen en consola.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@electrohome.com

# Opcional en local. Si se dejan vacías, los archivos subidos (reseñas, banners)
# se guardan en el sistema de archivos local en vez de Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional en local (modo sandbox de pruebas si se dejan vacías).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_ENVIRONMENT=test

# ===== Solo para PRODUCCIÓN (Render) =====
# Estas se configuran como variables de entorno en el panel de Render,
# NO en este archivo local.
# ALLOWED_HOSTS=electrohome.site,www.electrohome.site
# CSRF_TRUSTED_ORIGINS=https://electrohome.site,https://www.electrohome.site
